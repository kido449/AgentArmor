# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# GROQ_API_KEY: Primary LLM judge and agent LLM (llama-3.3-70b-versatile).
GROQ_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# LiveKit Cloud credentials (required for voice ingestion)
# Sign up at https://cloud.livekit.io for free tier
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Deepgram API key (required for LiveKit STT / speech-to-text)
# Sign up at https://console.deepgram.com for free tier (200 hrs/month)
DEEPGRAM_API_KEY=""