{
  "rewrites": [
    {
      "source": "/api/sentinel/:path*",
      "destination": "https://agentarmor-production.up.railway.app/api/sentinel/:path*"
    },
    {
      "source": "/stream",
      "destination": "https://agentarmor-production.up.railway.app/stream"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
